rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || request.auth.token.email == "nikhilkumaru55@gmail.com");
      allow update: if request.auth != null && request.auth.token.email == "nikhilkumaru55@gmail.com";
    }
  }
}
